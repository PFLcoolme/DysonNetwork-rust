FROM rust:1.91-bookworm AS builder
WORKDIR /app
COPY . .
RUN cargo build --locked --release --package starfur-gateway

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/starfur-gateway /usr/local/bin/starfur-gateway
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["starfur-gateway"]
